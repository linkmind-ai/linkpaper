APP_NAME="LinkPaper API"
ENVIRONMENT="local"
API_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# 외부 서비스 어댑터를 구현할 때 사용할 연결 정보
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-5.6-luna"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="linkpaper-password"
QDRANT_URL="http://localhost:6333"
POSTGRES_DB="linkpaper"
POSTGRES_USER="linkpaper"
POSTGRES_PASSWORD="linkpaper-password"
DATABASE_URL="postgresql://linkpaper:linkpaper-password@postgres:5432/linkpaper"

# 로컬 Docker Compose 포트
BACKEND_PORT="8000"
NEO4J_HTTP_PORT="7474"
NEO4J_BOLT_PORT="7687"
QDRANT_HTTP_PORT="6333"
QDRANT_GRPC_PORT="6334"
POSTGRES_PORT="5432"

# --- 평가/벤치마크 (evaluation/) ---
# --- 인덱싱·검색·평가 공통 설정 ---
# 서비스 DB와 분리하려면 evaluation/docker-compose.eval.yml의 포트를 쓴다.
QDRANT_API_KEY=""
QDRANT_COLLECTION="linkpaper_chunks_openai_3_large_1536_v1" # linkpaper_chunks_openai_3_small_1536_v1
NEO4J_DATABASE="neo4j"

# hash = 네트워크·API 키 없이 도는 결정적 임베더 (CI·배관 검증용)
# openai = 실제 품질 비교용. 인덱스를 만든 모델과 반드시 일치시킬 것
LINKPAPER_EMBEDDING_PROVIDER="openai" # or hash
LINKPAPER_EMBEDDING_MODEL="text-embedding-3-large" #small 
LINKPAPER_EMBEDDING_DIMENSIONS="1536"
LINKPAPER_EMBEDDING_VERSION="openai-3-large-1536-v1" #openai-3-small-1536-v1
LINKPAPER_SCHEMA_VERSION="v1"

# false면 참고문헌 원문은 Neo4j에만 보존하고 벡터 검색에서는 제외
# true면 참고문헌 청크도 Qdrant에 적재
INDEXING_INCLUDE_REFERENCE_CHUNKS="false" #true

# --target http 로 백엔드를 평가할 때의 주소
LINKPAPER_API_URL="http://localhost:8000"
# true: 백엔드 없이 하드코딩된 목업 데이터/스트리밍으로 동작
# false: 실제 FastAPI 엔드포인트(/api/chat/stream)를 호출
VITE_USE_MOCK=true

# 백엔드가 준비된 후 사용할 API base 경로 (vite proxy와 함께 사용)
VITE_API_BASE=/api
